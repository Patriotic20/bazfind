# docker compose only. Copy to `.env` — compose substitutes ${VAR} from the file
# sitting next to docker-compose.yml and from nowhere else, so without that copy
# every port below falls back to the defaults baked into the compose file.
#
# Application settings are not here. They live in `backend/.env`, which compose
# passes to the backend container as `env_file` and pydantic-settings reads
# directly for a local run.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=baz

# Host-side published ports. Container ports never change. Override any of these
# that another stack on this machine already holds.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
