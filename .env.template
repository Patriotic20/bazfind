# Every setting is namespaced with APP_CONFIG__ and nested with __.
# This file ships safe defaults and is loaded first; .env overrides it.

# --- database ---
APP_CONFIG__DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/baz
APP_CONFIG__DATABASE__ECHO=false
APP_CONFIG__DATABASE__ECHO_POOL=false
APP_CONFIG__DATABASE__POOL_SIZE=5
APP_CONFIG__DATABASE__MAX_OVERFLOW=10

# --- run ---
APP_CONFIG__RUN__HOST=0.0.0.0
APP_CONFIG__RUN__PORT=8000
APP_CONFIG__RUN__RELOAD=false

# --- api ---
APP_CONFIG__API__PREFIX=/api
APP_CONFIG__API__V1=/v1
APP_CONFIG__API__V2=/v2

# --- cors --- (list values are JSON)
APP_CONFIG__CORS__ORIGINS=["*"]
APP_CONFIG__CORS__ALLOW_CREDENTIALS=true
APP_CONFIG__CORS__ALLOW_METHODS=["*"]
APP_CONFIG__CORS__ALLOW_HEADERS=["*"]

# --- logging ---
APP_CONFIG__LOGGING__LEVEL=INFO
APP_CONFIG__LOGGING__FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(request_id)s | %(message)s

# --- docker-compose ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=baz
# Host-side published ports. Override if these are already taken locally.
POSTGRES_PORT=5432
BACKEND_PORT=8000

# --- security ---
APP_CONFIG__SECURITY__SECRET_KEY=dev-only-change-me-32-bytes-min!!
APP_CONFIG__SECURITY__ACCESS_TOKEN_TTL_MINUTES=15
APP_CONFIG__SECURITY__REFRESH_TOKEN_TTL_DAYS=30

# --- webhooks --- (empty disables the provider)
APP_CONFIG__WEBHOOKS__PAYME_SECRET=
APP_CONFIG__WEBHOOKS__CLICK_SECRET=
