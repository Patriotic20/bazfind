# Copy to .env.local.
#
# Where the browser sends API requests. This is inlined into the bundle at build
# time, so it has to be an address the user's machine can resolve -- inside
# docker compose that is still the published host port, never the `backend`
# service name.
#
# Keep it in step with APP_CONFIG__CORS__ORIGINS in ../backend/.env. If the page
# loads but every request fails while curl works, those two have drifted apart.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
